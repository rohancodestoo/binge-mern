yarn-error.log*

# --- Build output ---
client/dist/
client/build/

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Editor ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
